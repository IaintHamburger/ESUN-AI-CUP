# ==============================================================================
# .env.example — 環境變數範本（可以上傳到 GitHub，不含真實 Key）
# 使用方式：複製此檔案為 .env，然後填入真實的 API Key
# ==============================================================================

# AI API
GOOGLE_API_KEY=your-gemini-api-key-here

# 台股資料 API（免費申請：https://developer.fugle.tw/）
FUGLE_API_KEY=your-fugle-api-key-here

# 比賽提交 Token（主辦方發放）
ESUN_API_TOKEN=

# 選填
CMONEY_API_KEY=
